# Server
PORT=3000

# Meta Webhook Verify Token (must match UI Verify token)
VERIFY_TOKEN=replace_me

# Meta App Secret (optional but recommended for signature validation)
APP_SECRET=replace_me

# WhatsApp Cloud API
GRAPH_VERSION=v22.0
PHONE_NUMBER_ID=replace_me
WABA_ID=replace_me
ACCESS_TOKEN=replace_me

# Optional forwarder
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/xxxxx

# Optional: restrict who can call /send (bearer token)
ADMIN_BEARER=replace_me
